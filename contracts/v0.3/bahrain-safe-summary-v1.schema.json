{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexlab.local/contracts/v0.3/bahrain-safe-summary-v1.schema.json",
  "title": "ApexLab Bahrain v0.3 safe validation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "status",
    "validationDate",
    "gameBuild",
    "applicationVersion",
    "adapterId",
    "contractId",
    "decoderId",
    "canonicalSchemaId",
    "lapAuditId",
    "alignmentId",
    "referenceId",
    "cornerRevisionId",
    "detectorId",
    "experimentProtocolId",
    "baselineMinimumMet",
    "findingDisposition",
    "experimentOutcome",
    "deterministicReplay",
    "provenanceComplete",
    "privateDataExcluded",
    "conclusion"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "schemaId": { "type": "string", "const": "bahrain-safe-summary-v1" },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "validationDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "gameBuild": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^/\\\\:]*$" },
    "applicationVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "adapterId": { "type": "string", "const": "ea-f1-25-v3" },
    "contractId": { "type": "string", "const": "apexlab-bahrain-tt-slice-v1" },
    "decoderId": { "type": "string", "const": "f125-v3-minimal-decoder-v1" },
    "canonicalSchemaId": { "type": "string", "const": "apexlab-canonical-sample-v1" },
    "lapAuditId": { "type": "string", "const": "bahrain-tt-lap-audit-v1" },
    "alignmentId": { "type": "string", "const": "distance-grid-1m-v1" },
    "referenceId": { "type": "string", "const": "personal-reference-medoid-v1" },
    "cornerRevisionId": { "type": "string", "const": "bahrain-corner-revision-v1" },
    "detectorId": { "type": "string", "const": "brake-onset-detector-v1" },
    "experimentProtocolId": { "type": "string", "const": "single-braking-experiment-v1" },
    "baselineMinimumMet": { "type": "boolean" },
    "findingDisposition": { "type": "string", "enum": ["finding", "abstained"] },
    "experimentOutcome": { "type": "string", "enum": ["supported", "rejected", "inconclusive", "not_followed", "expired", "not_run"] },
    "deterministicReplay": { "type": "boolean" },
    "provenanceComplete": { "type": "boolean" },
    "privateDataExcluded": { "type": "boolean" },
    "conclusion": { "type": "string", "enum": ["PASS", "FAIL"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "baselineMinimumMet": { "const": true },
          "findingDisposition": { "const": "finding" },
          "experimentOutcome": { "enum": ["supported", "rejected", "inconclusive", "not_followed", "expired"] },
          "deterministicReplay": { "const": true },
          "provenanceComplete": { "const": true },
          "privateDataExcluded": { "const": true },
          "conclusion": { "const": "PASS" }
        }
      }
    },
    {
      "if": { "properties": { "findingDisposition": { "const": "abstained" } }, "required": ["findingDisposition"] },
      "then": {
        "properties": {
          "status": { "const": "failed" },
          "experimentOutcome": { "const": "not_run" },
          "conclusion": { "const": "FAIL" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "conclusion": { "const": "FAIL" } } }
    }
  ]
}
