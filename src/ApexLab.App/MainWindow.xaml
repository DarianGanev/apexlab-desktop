<Window x:Class="ApexLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ApexLab — Telemetry Coaching Workbench"
        Width="1360"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E14"
        Foreground="#EEF2F6"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111822" />
        <SolidColorBrush x:Key="RaisedPanelBrush" Color="#17212D" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#2A3949" />
        <SolidColorBrush x:Key="AccentBrush" Color="#39D98A" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#173B31" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9EACBB" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="StrongFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-4"
                                BorderBrush="#80E8B5"
                                BorderThickness="2"
                                CornerRadius="7" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationSelectionStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#DCE5ED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.ItemStatus" Value="Not selected" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="SelectedIndicator"
                                    Width="4"
                                    Margin="0,8"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1D2A37" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#34485C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#173B31" />
                                <Setter Property="Foreground" Value="#A6F2CE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#31795E" />
                                <Setter TargetName="SelectedIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#C7F9E2" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="Selected" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DCE5ED" />
            <Setter Property="Background" Value="#141E29" />
            <Setter Property="BorderBrush" Value="#2A3949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongFocusVisual}" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,0"
                Background="#0D131B"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Text="APEXLAB" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               Text="TELEMETRY COACHING WORKBENCH" />
                </StackPanel>
                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="12,7"
                        Background="{StaticResource AccentMutedBrush}"
                        BorderBrush="#286F54"
                        BorderThickness="1"
                        CornerRadius="14"
                        AutomationProperties.Name="Application status: Foundation build, offline">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock Foreground="#A6F2CE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="LOCAL • F1 25" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20,26"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                        <TextBlock Margin="8,0,0,14"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="WORKFLOW" />
                        <RadioButton x:Name="DriveNavigation"
                                     Tag="PrimaryNavigation"
                                     GroupName="PrimaryWorkflow"
                                     Content="_Drive"
                                     IsChecked="{Binding IsDriveSelected, Mode=OneWay}"
                                     Command="{Binding SelectAreaCommand}"
                                     CommandParameter="{Binding PrimaryAreas[0]}"
                                     Style="{StaticResource NavigationSelectionStyle}"
                                     AutomationProperties.Name="Drive" />
                        <RadioButton x:Name="ReviewNavigation"
                                     Tag="PrimaryNavigation"
                                     GroupName="PrimaryWorkflow"
                                     Content="_Review"
                                     IsChecked="{Binding IsReviewSelected, Mode=OneWay}"
                                     Command="{Binding SelectAreaCommand}"
                                     CommandParameter="{Binding PrimaryAreas[1]}"
                                     Style="{StaticResource NavigationSelectionStyle}"
                                     AutomationProperties.Name="Review" />
                        <StackPanel x:Name="ReviewToolsPanel"
                                    Margin="24,0,0,10"
                                    Visibility="{Binding AreReviewToolsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="8,4,0,3"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="REVIEW TOOLS" />
                            <Button x:Name="CornerEditorButton"
                                    Content="Corner Editor"
                                    Command="{Binding OpenCornerEditorCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Open Corner Editor within Review" />
                        </StackPanel>
                        <RadioButton x:Name="CoachNavigation"
                                     Tag="PrimaryNavigation"
                                     GroupName="PrimaryWorkflow"
                                     Content="_Coach"
                                     IsChecked="{Binding IsCoachSelected, Mode=OneWay}"
                                     Command="{Binding SelectAreaCommand}"
                                     CommandParameter="{Binding PrimaryAreas[2]}"
                                     Style="{StaticResource NavigationSelectionStyle}"
                                     AutomationProperties.Name="Coach" />
                        <RadioButton x:Name="DataSettingsNavigation"
                                     Tag="PrimaryNavigation"
                                     GroupName="PrimaryWorkflow"
                                     Content="Data &amp; _Settings"
                                     IsChecked="{Binding IsDataSettingsSelected, Mode=OneWay}"
                                     Command="{Binding SelectAreaCommand}"
                                     CommandParameter="{Binding PrimaryAreas[3]}"
                                     Style="{StaticResource NavigationSelectionStyle}"
                                     AutomationProperties.Name="Data and Settings" />
                        <StackPanel x:Name="DataToolsPanel"
                                    Margin="24,0,0,0"
                                    Visibility="{Binding AreDataToolsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="8,4,0,3"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Text="DATA TOOLS" />
                        <Button x:Name="ReplayDiagnosticsButton"
                                Content="Replay &amp; Diagnostics"
                                Command="{Binding OpenReplayDiagnosticsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Open Replay and Diagnostics within Data and Settings" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Padding="34,30"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentRoute, StringFormat=WORKSPACE  /  {0}}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedArea.Title}" />
                            <TextBlock Margin="0,8,0,0"
                                       MaxWidth="720"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="15"
                                       Text="{Binding SelectedArea.Purpose}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Margin="24,0,0,0"
                                Padding="14,9"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="Milestone v0.2" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="LIVE CAPTURE" />
                                <TextBlock Margin="0,13,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding Capture.StatusText}" />
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="14"
                                           LineHeight="22"
                                           Text="In F1 25, set UDP On, UDP mode to F1 25, IP address to 127.0.0.1, and port to 20777. ApexLab expects the base v3 telemetry source."
                                           TextWrapping="Wrap" />
                                <Border Margin="0,24,0,0"
                                        Padding="16"
                                        Background="#101720"
                                        BorderBrush="#273645"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,14,0"
                                                   Foreground="#F4C46B"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Text="PRIVATE • LOCAL" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="13"
                                                   Text="Raw evidence remains on this PC. Written records become final evidence only when the completion manifest is committed."
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,18,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="ArmCaptureButton"
                                            Width="150"
                                            Height="42"
                                            Margin="0,0,10,0"
                                            Content="_Arm capture"
                                            Command="{Binding Capture.ArmCommand}"
                                            AutomationProperties.Name="Arm F1 25 capture" />
                                    <Button x:Name="StopCaptureButton"
                                            Width="150"
                                            Height="42"
                                            Margin="0,0,10,0"
                                            Content="_Stop capture"
                                            Command="{Binding Capture.StopCommand}"
                                            AutomationProperties.Name="Stop and finalize F1 25 capture" />
                                    <Button x:Name="ResetCaptureButton"
                                            Width="130"
                                            Height="42"
                                            Content="_Reset fault"
                                            Command="{Binding Capture.ResetCommand}"
                                            AutomationProperties.Name="Reset resolved capture fault"
                                            AutomationProperties.HelpText="Enabled only after faulted capture ownership and cleanup have resolved." />
                                </StackPanel>
                                <UniformGrid Margin="0,18,0,0"
                                             Columns="6">
                                    <TextBlock Text="{Binding Capture.ReceivedText, StringFormat=Received {0}}"
                                               ToolTip="Received is the aggregate number of loopback datagrams observed by the bounded source."
                                               AutomationProperties.HelpText="Received counts aggregate datagrams only; no sender or payload detail is displayed." />
                                    <TextBlock Text="{Binding Capture.CompatibleText, StringFormat=Compatible {0}}"
                                               ToolTip="Compatible records passed the F1 25 base-v3 envelope and privacy policy; they are not necessarily durable."
                                               AutomationProperties.HelpText="Compatible does not mean written or finalized." />
                                    <TextBlock Text="{Binding Capture.ActivePendingText, StringFormat=Pending {0}}"
                                               ToolTip="Active pending records are classified but their write has not completed."
                                               AutomationProperties.HelpText="Active pending records are not yet written or durable." />
                                    <TextBlock Text="{Binding Capture.DeferredPendingText, StringFormat=Deferred {0}}"
                                               ToolTip="Deferred pending records are still owned by background cleanup and remain provisional."
                                               AutomationProperties.HelpText="Deferred pending counts may change until cleanup resolves." />
                                    <TextBlock Text="{Binding Capture.WrittenText, StringFormat=Written {0}}"
                                               ToolTip="Written records are staged; they are not final evidence before the completion manifest."
                                               AutomationProperties.HelpText="Written records are staged and are not final evidence." />
                                    <TextBlock Text="{Binding Capture.FinalizedText, StringFormat=Finalized {0}}"
                                               ToolTip="Finalized records have a committed completion manifest and flushed file contents."
                                               AutomationProperties.HelpText="Finalized means the completion manifest was committed; directory-entry crash durability is not claimed." />
                                </UniformGrid>
                                <Border Margin="0,16,0,0"
                                        Padding="10,7"
                                        HorizontalAlignment="Left"
                                        Background="#493817"
                                        BorderBrush="#7E6427"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding Capture.IsProvisional, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding Capture.ProvisionalText}"
                                        AutomationProperties.HelpText="Provisional counters may change while deferred cleanup still owns writes.">
                                    <TextBlock Foreground="#F4C46B"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Text="{Binding Capture.ProvisionalText}" />
                                </Border>
                                <TextBlock Margin="0,16,0,0"
                                           FontWeight="SemiBold"
                                           Text="Aggregate diagnostics" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding Capture.DiagnosticText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           FontWeight="SemiBold"
                                           Text="Next step" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding Capture.NextStepText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="{Binding Capture.DurabilityText}"
                                           TextWrapping="Wrap"
                                           ToolTip="Pending is not written; written is staged; finalized requires a committed completion manifest."
                                           AutomationProperties.HelpText="Evidence durability help: directory-entry crash durability is not claimed." />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="PRODUCT LOOP" />
                                <TextBlock Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" Text="01  Connect" />
                                <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Text="02  Build baseline" />
                                <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Text="03  Review one issue" />
                                <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Text="04  Run experiment" />
                                <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Text="05  Measure result" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Margin="2,24,0,0"
                               Foreground="#748495"
                               FontSize="12"
                               Text="Local-first • Private by design • Deterministic evidence before recommendations" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Padding="26,0"
                Background="#0D131B"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           Text="{Binding Capture.StatusText, StringFormat=STATUS  •  {0}}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           Text="Alt+D / Alt+R / Alt+C / Alt+S" />
            </Grid>
        </Border>
    </Grid>
</Window>
