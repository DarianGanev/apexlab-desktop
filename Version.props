<Project>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <Target Name="ValidatePublishedVersion" BeforeTargets="Publish" Condition="'$(Version)' != '$(VersionPrefix)'">
    <Error Text="Requested version '$(Version)' must match VersionPrefix '$(VersionPrefix)' in Version.props." />
  </Target>
</Project>
